+def _pearson_shift(ref_b: np.ndarray, img, cx: float, cy: float,
+                   bin_: int = 4) -> float:
+    """旋转判别：把 img 按 (cx, cy) 平移后与参考像的相关系数（-1 表示无效）
+
+    分箱后只看中心 3/4 区域：星点场的位置比对必须"整幅像对得上"才算数，
+    单看星点重心会被"窗口里恰好有别的星"骗过去。
