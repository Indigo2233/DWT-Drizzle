+def plane(img: np.ndarray, pattern: str, ch: str) -> np.ndarray:
+    """从 CFA 图里取出一个通道的整幅图层（双线性思路）。
+
+    该通道的真实像素原样保留；其余位置用 3×3 邻域内同色像素的加权均值补齐。
+    """
+    h, w = img.shape[:2]
+    sel = _tile(_mask(pattern, ch), h, w)
