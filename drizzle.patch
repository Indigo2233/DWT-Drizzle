+def superpixel(img: np.ndarray, pattern: str) -> np.ndarray:
+    """2×2 合并成 RGB，返回 (h//2, w//2, 3) float32。
+
+    每个 2×2 内恰好有 1 红、2 绿、1 蓝（RGGB/BGGR/GRBG/GBRG 都是这个结构），
+    绿取两个像素均值。
