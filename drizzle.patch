+def _bin4(a: np.ndarray, bin_: int = 4) -> np.ndarray:
+    """4×4 分箱平均（旋转判别用，只要求形状，不要求精度）"""
+    h, w = int(a.shape[0]), int(a.shape[1])
+    h -= h % bin_
+    w -= w % bin_
+    return a[:h, :w].reshape(h // bin_, bin_, w // bin_, bin_).mean(axis=(1, 3))
