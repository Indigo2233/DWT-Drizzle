+    p = np.pad(a, 1, mode='edge')
+    out = np.zeros_like(a, dtype=np.float32)
+    h, w = a.shape
+    for dy in range(3):
+        for dx in range(3):
+            wgt = float(k[dy, dx])
+            if wgt:
+                out += wgt * p[dy:dy + h, dx:dx + w]
+    return out
