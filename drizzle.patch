+def read_frame_hint(path: Path):
+    """轻量读取单帧的 (滤镜名, 帧类型)：只读文件头，不解码像素。
+
+    帧类型取 IMAGETYP / Property Instrument:FrameType，统一大写。
+    用途：WBPP 的 calibrated/ 目录里 Flat/Dark/Bias 与 Light 混在同一棵树
+    下、且 FILTER 卡同名，只按滤镜分组会把平场当成光的帧叠进去。
+    读不到就返回 ('', '')，调用方自行决定保留还是跳过。
+    """
+    suffix = path.suffix.lower()
+    try:
+        if suffix in FITS_SUFFIXES:
+            hdr = fits.getheader(path)
+            fil = str(hdr.get('FILTER', '') or '').strip().strip("'").strip()
+            typ = str(hdr.get('IMAGETYP', '') or hdr.get('FRAMETYP', '') or '')
+            return fil, typ.strip().strip("'").strip().upper()
+        if suffix == '.xisf':
+            import xml.etree.ElementTree as ET
+            with open(path, 'rb') as f:
+                head = f.read(16)
+                if len(head) < 16 or not head.startswith(b'XISF'):
+                    return '', ''
+                (hlen,) = struct.unpack_from('<I', head, 8)
+                xml_text = f.read(hlen).decode('utf-8', 'ignore')
+            try:
+                root = ET.fromstring(xml_text)
+            except ET.ParseError:
+                return '', ''
+            fil = typ = ''
+            for el in root.iter():
+                tag = el.tag.rsplit('}', 1)[-1]
+                if tag == 'FITSKeyword':
+                    name = el.get('name', '').upper()
+                    val = (el.get('value', '') or '').strip().strip("'").strip()
+                    if name == 'FILTER' and not fil:
+                        fil = val
+                    elif name == 'IMAGETYP' and not typ:
+                        typ = val.upper()
+                elif tag == 'Property' and el.get('id', '') == 'Instrument:FrameType' and not typ:
+                    typ = (el.get('value', '') or '').strip().upper()
+            if not fil:
+                for el in root.iter():
+                    if el.tag.rsplit('}', 1)[-1] == 'Property' and \
+                            el.get('id', '') == 'Instrument:Filter:Name':
+                        fil = (el.get('value', '') or '').strip().strip("'").strip()
+                        break
+            return fil, typ
+    except Exception:
+        return '', ''
+    return '', ''
+
+
